{
  "name": "switchboard",
  "productName": "Switchboard",
  "version": "1.0.0",
  "description": "One inbox for WhatsApp, Messenger and Instagram with ghost read, saved deleted messages, per-account proxies and quiet Instagram posting.",
  "main": "main.js",
  "author": "Rick",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "electron-updater": "^6.8.11",
    "playwright-core": "^1.49.0",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.switchboard.inbox",
    "productName": "Switchboard",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "asarUnpack": [
      "node_modules/playwright-core/**"
    ],
    "extraResources": [
      {
        "from": "engine/bin",
        "to": "engine",
        "filter": [
          "engine.exe"
        ]
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Switchboard",
      "runAfterFinish": true,
      "artifactName": "Switchboard-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rickbesada-netizen",
        "repo": "Switchboard"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rickbesada-netizen/Switchboard.git"
  }
}
